{
  "expo": {
    "name": "Daily Loop",
    "slug": "daily-loop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailyloop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dailyloop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3E6A9C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "루틴/사진일기에 사진을 첨부하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "사진일기 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "사진일기 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "사진일기를 사진 보관함에 저장하기 위해 접근합니다.",
          "savePhotosPermission": "사진일기를 사진 보관함에 저장하기 위해 접근합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f452526f-acca-43cf-bc95-25fbf8e13de3"
      }
    },
    "owner": "leeoyonghee030"
  }
}
